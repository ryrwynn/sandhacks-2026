# .env  (never committed; Claude Code is blocked from reading it in step 3)
BRIGHTDATA_API_TOKEN=
DATABASE_URL=            # paste from the Tiger config file; keep ?sslmode=require
GEMINI_API_KEY=
PARSE_MODEL=             # a Flash model that returned HTTP 200 in your test, e.g. gemini-3.8-flash
LETTER_MODEL=            # a Pro model that returned 200, or the same Flash model
GEMINI_FALLBACK_MODEL=   # a second model that returned 200 or 503, e.g. gemini-3.1-flash-lite
CENSUS_API_KEY=
VULTR_HOST=              # server IP, e.g. 203.0.113.10
PUBLIC_HOST=             # your GoDaddy Registry domain, e.g. rentorknot.us
PUBLIC_URL=              # https:// plus the same domain
MAP_BOX_API_KEY=         # Mapbox public token (starts with pk.), URL-restricted to your domain and localhost
LLM_EXTRACT_MAX_PER_RUN= # optional: Gemini listing parses per worker run (default 40)

# Overnight run (docs/NIGHT.md)
BRIGHTDATA_BUDGET_USD=     # max Bright Data spend for one overnight run, e.g. 10
DEV_DATABASE_URL=          # optional: a second Tiger service for testing loads; keep ?sslmode=require
FRED_API_KEY=              # optional: FRED also serves keyless CSVs
GOOGLE_CLIENT_ID=          # optional: Google sign-in (redirect URI https://rentorknot.us/auth/callback/google)
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=               # optional: openssl rand -base64 32
