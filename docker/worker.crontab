# m h dom mon dow  command   (UTC; logs go to the container's stdout)
# Zillow rentals once a week: Thursday 12:00 UTC = 4:00 AM Pacific standard time (5:00 AM during daylight time).
# Weekly because limit_per_input isn't a hard cap (~1,777 records a run); see docs/WAKEUP.md for the cost.
0 12 * * 4   /app/docker/worker-job.sh python -m worker.run --source zillow_rent
30 4 * * *   /app/docker/worker-job.sh python -m worker.run --source zillow_sale
0 6 * * *    /app/docker/worker-job.sh python -m worker.train
# Facebook rental groups, Mondays and Thursdays 15:00 UTC (7-8am Pacific), up to 50 posts per group.
# --cron refuses unless sources.terms_checked_on is set for facebook_groups_sd (the owner sets it).
# Shared target loads data/zips.txt ZIPs only; other ZIPs stay in staging.
0 15 * * 1,4 /app/docker/worker-job.sh python -m worker.facebook collect --limit 50 --target shared --confirm-shared --cron
# Areas people asked for (/areas "Add this area"): daily, within ONDEMAND_DAILY_USD (default $1) and the overall
# Bright Data budget; requests that don't fit wait for the next day. Rows go to raw_records and staging only.
30 13 * * *  /app/docker/worker-job.sh python -m worker.ondemand
